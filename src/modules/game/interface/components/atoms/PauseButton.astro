---
// src/modules/game/interface/components/atoms/PauseButton.astro
import uiEs from "@/i18n/ui.es.json";
import uiEn from "@/i18n/ui.en.json";
import AppPillButton from "@/modules/game/interface/components/atoms/AppPillButton.astro";

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;
const ui = locale === 'es' ? uiEs : uiEn;
---

<div class="pause-hud-container no-print">
  <AppPillButton id="pause-game-btn" type="button">
    <span class="pause-icon">⏸</span>
    <span class="pause-label">{ui.game.pauseButton}</span>
  </AppPillButton>
</div>

<style>
  .pause-hud-container {
    display: none; /* Controlled dynamically by Nanostores subscription */
  }

  .pause-icon {
    font-size: 14px;
  }

  .pause-label {
    font-weight: 500;
  }
</style>

<script>
  import { isStartedStore } from "@/modules/game/application/store";

  document.addEventListener('DOMContentLoaded', () => {
    const pauseBtn = document.getElementById('pause-game-btn');
    const container = document.querySelector('.pause-hud-container') as HTMLElement | null;

    if (pauseBtn) {
      pauseBtn.addEventListener('click', () => {
        isStartedStore.set(false);
      });
    }

    // Toggle Pause button visibility based on isStartedStore
    isStartedStore.subscribe((started) => {
      if (container) {
        container.style.display = started ? 'block' : 'none';
      }
    });
  });
</script>
