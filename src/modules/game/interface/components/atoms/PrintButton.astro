---
// src/modules/game/interface/components/atoms/PrintButton.astro
import uiEs from "@/i18n/ui.es.json";
import uiEn from "@/i18n/ui.en.json";
import AppPillButton from "@/modules/game/interface/components/atoms/AppPillButton.astro";

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;
const ui = locale === 'es' ? uiEs : uiEn;
---

<div class="print-hud-container no-print">
  <AppPillButton id="print-cv-btn" type="button" aria-label={ui.actions.print}>
    <span class="print-icon" aria-hidden="true">🖨</span>
    <span class="print-hud-label">{ui.actions.print}</span>
  </AppPillButton>
</div>

<style>
  .print-hud-container {
    display: none; /* Controlled dynamically by Nanostores subscription */
  }

  .print-icon {
    font-size: 14px;
    line-height: 1;
  }

  .print-hud-label {
    font-weight: 500;
  }
</style>

<script>
  import { isStartedStore } from "@/modules/game/application/store";

  document.addEventListener('DOMContentLoaded', () => {
    const printBtn = document.getElementById('print-cv-btn');
    const container = document.querySelector('.print-hud-container') as HTMLElement | null;

    if (printBtn) {
      printBtn.addEventListener('click', () => {
        window.print();
      });
    }

    // Visible only while the game is running. Same pattern as PauseButton.
    isStartedStore.subscribe((started) => {
      if (container) {
        container.style.display = started ? 'block' : 'none';
      }
    });

    // Keyboard shortcut (P) — Slice C WU-2.
    window.addEventListener('print-requested', () => {
      window.print();
    });
  });
</script>
