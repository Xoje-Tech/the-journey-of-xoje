---
// src/modules/game/interface/components/atoms/AppPillButton.astro
import AppButton from "./AppButton.astro";

interface Props {
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  'aria-expanded'?: string;
  'aria-haspopup'?: string;
  'aria-label'?: string;
}

const {
  id,
  type = 'button',
  class: className = '',
  'aria-expanded': ariaExpanded,
  'aria-haspopup': ariaHaspopup,
  'aria-label': ariaLabel,
} = Astro.props;
---

<AppButton
  id={id}
  type={type}
  class={`app-pill-btn ${className}`}
  aria-expanded={ariaExpanded}
  aria-haspopup={ariaHaspopup}
  aria-label={ariaLabel}
>
  <slot />
</AppButton>

<style is:global>
  /* 
   * Usamos is:global para inyectar la clase del wrapper de manera libre en el DOM,
   * consumiendo estrictamente la jerarquía de Design Tokens de screen.css.
   */
  .app-pill-btn {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--comp-button-pill-bg);
    border: 1px solid var(--comp-button-pill-border);
    border-radius: var(--comp-button-pill-radius);
    color: var(--primitive-color-secondary);
    font-family: ui-monospace, 'JetBrains Mono', Menlo, Consolas, monospace;
    font-size: 13px;
    box-shadow: var(--comp-button-pill-shadow);
    transition:
      transform 140ms cubic-bezier(0.25, 1, 0.5, 1),
      background 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .app-pill-btn:hover {
    background: var(--comp-button-pill-bg-hover);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-1px);
  }

  .app-pill-btn:active {
    /* Tactile press: sink the pill and cut the drop shadow. */
    transform: translateY(1px) scale(0.98);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  /* 
   * Sincronizamos el foco con el comportamiento de hover:
   * Usamos :focus para contemplar tanto foco por Tab como foco programático por flechas/gamepad.
   * Declaramos también :focus-visible para cumplir estrictamente con el contrato estático de tests.
   */
  .app-pill-btn:focus,
  .app-pill-btn:focus-visible {
    outline: none;
    background: var(--comp-button-pill-bg-hover);
    transform: translateY(-1px);
    border-color: var(--semantic-color-border-focus);
    box-shadow: 
      0 0 0 2px var(--primitive-color-primary), 
      0 0 0 4px var(--primitive-color-secondary), 
      var(--comp-button-pill-shadow);
  }

  @media (prefers-reduced-motion: reduce) {
    .app-pill-btn {
      transition-duration: 0.01ms;
    }
    .app-pill-btn:hover,
    .app-pill-btn:focus,
    .app-pill-btn:focus-visible {
      transform: none;
    }
    .app-pill-btn:active {
      transform: none;
    }
  }
</style>
