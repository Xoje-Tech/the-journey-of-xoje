---
// src/modules/game/interface/components/organisms/QualBag.astro
import { SKILL_TEMPLATES } from "@/modules/game/infrastructure/init";
import RetroModal from "@/modules/game/interface/components/atoms/RetroModal.astro";
import SkillCard from "@/modules/game/interface/components/molecules/SkillCard.astro";
import AppPillButton from "@/modules/game/interface/components/atoms/AppPillButton.astro";
import uiEs from "@/i18n/ui.es.json";
import uiEn from "@/i18n/ui.en.json";

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;
const ui = locale === 'es' ? uiEs : uiEn;

const totalQual = SKILL_TEMPLATES.filter((s) => s.category === 'qualitative').length;
---

<AppPillButton
  id="qual-bag-hud"
  type="button"
  aria-haspopup="dialog"
  aria-expanded="false"
  class="no-print"
>
  <span class="hud-icon">💼</span>
  <span class="hud-label"
    >{ui.game.qualBagLabel}<strong id="qual-counter">0/{totalQual}</strong></span
  >
  <span id="qual-toast" class="hud-toast"></span>
</AppPillButton>

<RetroModal
  id="qual-skills-modal"
  title={ui.game.qualBagTitle}
  closeId="close-qual-modal"
  triggerId="qual-bag-hud"
>
  <div class="skills-grid">
    {
      SKILL_TEMPLATES.filter((s) => s.category === 'qualitative').map((s) => (
        <SkillCard id={s.id} name={s.name} biome={s.biome} />
      ))
    }
  </div>
</RetroModal>

<style>
  .hud-icon {
    font-size: 16px;
  }

  .hud-label {
    font-weight: 500;
  }

  .hud-toast {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 8px;
    padding: 4px 10px;
    background: #e67e22; /* Different color for Qualitative toasts */
    color: #fff;
    font-weight: bold;
    font-size: 11px;
    border-radius: 4px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-5px);
    transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .hud-toast.toast-active {
    opacity: 1;
    transform: translateY(0);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
</style>

<script>
  import { collectedSkillsStore } from "@/modules/game/application/store";
  import { SKILL_TEMPLATES } from "@/modules/game/infrastructure/init";

  document.addEventListener('DOMContentLoaded', () => {
    const qualBtn = document.getElementById('qual-bag-hud');
    const modal = document.getElementById('qual-skills-modal') as HTMLDialogElement | null;
    const counterEl = document.getElementById('qual-counter');
    const toastEl = document.getElementById('qual-toast');

    if (qualBtn && modal) {
      qualBtn.addEventListener('click', () => {
        modal.showModal();
        qualBtn.setAttribute('aria-expanded', 'true');
      });
    }

    let lastLen = 0;

    collectedSkillsStore.subscribe((skills) => {
      // Filter collected qualitative skills
      const qualCollected = skills.filter((id) => {
        const s = SKILL_TEMPLATES.find((t) => t.id === id);
        return s && s.category === 'qualitative';
      });

      // Update HUD Counter
      if (counterEl) {
        const total = counterEl.textContent?.split('/')[1] || '5';
        counterEl.textContent = `${qualCollected.length}/${total}`;
      }

      // Unlock matching cards
      qualCollected.forEach((id) => {
        const card = document.getElementById(`skill-card-${id}`);
        if (card) {
          card.classList.remove('skill-locked');
          card.classList.add('skill-unlocked');
        }
      });

      // Anim transient toast if a qualitative skill was just collected
      if (skills.length > lastLen) {
        const lastId = skills[skills.length - 1];
        const lastSkill = SKILL_TEMPLATES.find((t) => t.id === lastId);
        if (lastSkill && lastSkill.category === 'qualitative' && toastEl) {
          toastEl.textContent = `+ ${lastSkill.name}!`;
          toastEl.classList.add('toast-active');
          setTimeout(() => {
            toastEl.classList.remove('toast-active');
          }, 2500);
        }
      }

      lastLen = skills.length;
    });
  });
</script>
