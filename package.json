{
  "name": "the-journey-of-xoje",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static portfolio whose print output IS a Harvard-style CV. CV content is materialized at build time from a static DATA snapshot under tests/fixtures/portfolio/.",
  "scripts": {
    "build:cv": "node scripts/build-cv-static.mjs",
    "predev": "node scripts/build-cv-static.mjs",
    "dev": "astro dev",
    "generate-skill-sprites": "SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy LD_LIBRARY_PATH=/home/hermes/tools/squashfs-root/usr/lib /home/hermes/tools/squashfs-root/usr/bin/libresprite --batch --script scripts/generate-skill-sprites.js",
    "generate-lcs-building": "SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy LD_LIBRARY_PATH=/home/hermes/tools/squashfs-root/usr/lib /home/hermes/tools/squashfs-root/usr/bin/libresprite --batch --script scripts/generate-lcs-building.js",
    "generate-lcs-background": "SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy LD_LIBRARY_PATH=/home/hermes/tools/squashfs-root/usr/lib /home/hermes/tools/squashfs-root/usr/bin/libresprite --batch --script scripts/generate-lcs-background.js",
    "generate-crmble-background": "SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy LD_LIBRARY_PATH=/home/hermes/tools/squashfs-root/usr/lib /home/hermes/tools/squashfs-root/usr/bin/libresprite --batch --script scripts/generate-crmble-background.js",
    "generate-twinny-background": "SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy LD_LIBRARY_PATH=/home/hermes/tools/squashfs-root/usr/lib /home/hermes/tools/squashfs-root/usr/bin/libresprite --batch --script scripts/generate-twinny-background.js",
    "generate-rideon-background": "SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy LD_LIBRARY_PATH=/home/hermes/tools/squashfs-root/usr/lib /home/hermes/tools/squashfs-root/usr/bin/libresprite --batch --script scripts/generate-rideon-background.js",
    "generate-start-bg": "SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy LD_LIBRARY_PATH=/home/hermes/tools/squashfs-root/usr/lib /home/hermes/tools/squashfs-root/usr/bin/libresprite --batch --script scripts/generate-start-bg.js",
    "generate-start-icons": "SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy LD_LIBRARY_PATH=/home/hermes/tools/squashfs-root/usr/lib /home/hermes/tools/squashfs-root/usr/bin/libresprite --batch --script scripts/generate-start-icons.js",
    "build:astro": "astro build",
    "prebuild": "node scripts/build-cv-static.mjs",
    "build": "pnpm build:cv && astro build",
    "preview": "astro preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:a11y": "playwright test --config=playwright.visual.config.ts tests/e2e/storybook-a11y.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:agents": "node scripts/validate-agents.mjs",
    "lint": "eslint . && pnpm lint:agents",
    "format": "prettier --write \"**/*.{ts,astro,json,md,mjs,yml,yaml}\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "astro": "7.1.4",
    "nanostores": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/cli": "4.12.1",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@storybook-astro/framework": "1.11.0",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/builder-vite": "10.5.10",
    "@types/node": "^22.0.0",
    "eslint": "10.7.0",
    "eslint-plugin-astro": "3.0.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "lighthouse": "13.4.0",
    "pa11y": "9.1.1",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "storybook": "10.5.10",
    "ts-dedent": "2.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "1.6.1"
  }
}